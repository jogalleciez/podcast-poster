{
  "private": true,
  "name": "podcast-poster",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types ./tools/build.ts --minify",
    "deploy": "npm run build && devvit upload",
    "dev": "devvit playtest",
    "login": "devvit login",
    "launch": "npm run build && npm run deploy && devvit publish",
    "type-check": "tsc --build"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@devvit/web": "0.15.4",
    "fast-xml-parser": "^5.12.1",
    "node-html-markdown": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "devvit": "^0.15.4",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.9": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true
  }
}
